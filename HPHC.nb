Cell[TextData[{
 "\[Section] a key observation: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[CapitalPhi]", 
          StyleBox["l", "TI"]], 
         RowBox[{"(", 
           RowBox[{"\[Sigma]", "\[LongEqual]", "0"}], ")"}], "\[LongEqual]", 
         "0", ", ", 
         StyleBox["l", "TI"], ">", "0"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\Phi_l(\\sigma=0)=0,\\,l>0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5d6910bd-c29e-440a-b66e-e813a5637710"],
 ", because the equation reduces to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["l", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["l", "TI"], "+", "1"}], ")"}], 
         SubscriptBox["\[CapitalPhi]", 
          StyleBox["l", "TI"]], 
         RowBox[{"(", 
           RowBox[{"\[Sigma]", "\[LongEqual]", "0"}], ")"}], "\[LongEqual]", 
         "0"}], TraditionalForm], "errors" -> {}, "input" -> 
     "l(l+1)\\Phi_l(\\sigma=0)=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "283119ac-ef55-4496-a20d-5586f0fc9090"],
 ". "
}], "Text",
 CellChangeTimes->{{3.967230673900856*^9, 3.967230739525445*^9}, {
  3.96723077009927*^9, 
  3.967230819533567*^9}},ExpressionUUID->"6b910c38-07af-4811-a45e-\
95ac3b8e2df0"],


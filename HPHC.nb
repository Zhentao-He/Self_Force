Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"regular", " ", "condition", " ", "at", " ", 
    TemplateBox[<|"boxes" -> FormBox[
        RowBox[{"\[Sigma]", "\[LongEqual]", "0"}], TraditionalForm], 
      "errors" -> {}, "input" -> "\\sigma=0", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Al0", "[", 
      RowBox[{"[", 
       RowBox[{
        RowBox[{"-", "1"}], ",", ";;"}], "]"}], "]"}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "2"}], "*", 
       RowBox[{"d\[Sigma]", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"-", "1"}], ",", ";;"}], "]"}], "]"}]}], "+", "1"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"MatrixRank", "[", "Al0", "]"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     TemplateBox[<|"boxes" -> FormBox[
         RowBox[{"\[Delta]", 
           RowBox[{"(", 
             RowBox[{"\[Theta]", "-", 
               SuperscriptBox["\[Theta]", "\[Prime]"]}], ")"}], 
           "\[LongEqual]", "\[Sum]", 
           SubscriptBox["\[Delta]", 
            StyleBox["l", "TI"]], 
           SubscriptBox[
            StyleBox["P", "TI"], 
            StyleBox["l", "TI"]], 
           RowBox[{"(", 
             RowBox[{"cos", "\[Theta]"}], ")"}]}], TraditionalForm], 
       "errors" -> {}, "input" -> 
       "\\delta(\\theta-\\theta^\\prime)=\\sum \\delta_l P_l(\\cos\\theta)", 
       "state" -> "Boxes"|>,
      "TeXAssistantTemplate"], ",", 
     TemplateBox[<|"boxes" -> FormBox[
         RowBox[{
           SubscriptBox["\[Delta]", 
            StyleBox["l", "TI"]], "\[LongEqual]", 
           FractionBox[
            RowBox[{"2", 
              StyleBox["l", "TI"], "+", "1"}], "2"], 
           SubscriptBox[
            StyleBox["P", "TI"], 
            StyleBox["l", "TI"]], 
           RowBox[{"(", 
             RowBox[{"cos", 
               SuperscriptBox["\[Theta]", "\[Prime]"]}], ")"}], "sin", 
           SuperscriptBox["\[Theta]", "\[Prime]"]}], TraditionalForm], 
       "errors" -> {}, "input" -> 
       "\\delta_l=\\frac{2l+1}{2}P_l(\\cos\\theta^\\prime)\\sin\\theta^\\\
prime", "state" -> "Boxes"|>,
      "TeXAssistantTemplate"]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Delta]0", "=", 
     RowBox[{
      FractionBox["1", "2"], 
      RowBox[{"Sin", "[", 
       FractionBox["\[Pi]", "2"], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"b", "=", 
     RowBox[{"0", "*", "\[Sigma]\[Sigma]"}]}], ";", 
    RowBox[{
     RowBox[{"b", "[", 
      RowBox[{"[", 
       FractionBox[
        RowBox[{"n\[Sigma]", "+", "1"}], "2"], "]"}], "]"}], "=", 
     RowBox[{"1", "*", "\[Delta]0"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Phi0", " ", "=", 

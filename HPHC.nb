Cell[BoxData[{
 RowBox[{
  RowBox[{"zeroMode", "=", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"KroneckerProduct", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"NullSpace", "[", "A\[Sigma]", "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", 
       RowBox[{
        RowBox[{"NullSpace", "[", "Ax", "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "//", "Flatten"}], ")"}]}], 
  " ", ";"}], "\[IndentingNewLine]", 
 RowBox[{"ListPlot3D", "[", 
  RowBox[{
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{"\[Sigma]\[Sigma]", ",", 
         RowBox[{
          RowBox[{"0", "*", "xx"}], "+", "1"}]}], "]"}], "//", "Flatten"}], 
      ",", 
      RowBox[{
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"0", "*", "\[Sigma]\[Sigma]"}], "+", "1"}], ",", "xx"}], 
        "]"}], "//", "Flatten"}], ",", 
      RowBox[{"Abs", "[", "zeroMode", "]"}]}], "}"}], "]"}], ",", 
   RowBox[{"PlotRange", "->", "All"}], ",", 

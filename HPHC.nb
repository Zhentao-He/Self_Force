Cell[BoxData[{
 RowBox[{
  RowBox[{"Al0", "=", 
   RowBox[{
    RowBox[{"DiagonalMatrix", "[", "\[Sigma]\[Sigma]", "]"}], "+", 
    RowBox[{
     RowBox[{"DiagonalMatrix", "[", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "2"}], " ", "\[Sigma]\[Sigma]"}], "+", 
        RowBox[{"3", " ", 
         SuperscriptBox["\[Sigma]\[Sigma]", "2"]}]}], ")"}], "]"}], " ", ".", 
     "d\[Sigma]"}], "+", 
    RowBox[{
     RowBox[{"DiagonalMatrix", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "\[Sigma]\[Sigma]"}], ")"}], " ", 
       SuperscriptBox["\[Sigma]\[Sigma]", "2"]}], " ", "]"}], " ", ".", 
     "d\[Sigma]", ".", "d\[Sigma]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"zeroMode$\[Sigma]", "=", 
   RowBox[{
    RowBox[{"NullSpace", "[", "Al0", "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 

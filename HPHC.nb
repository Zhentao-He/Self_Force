Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Cheb", "[", 
     RowBox[{"n_", ",", "Z1_", ",", "Z2_", ",", 
      RowBox[{"myPrec_", ":", "MachinePrecision"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"b", ",", "c", ",", "d", ",", "x"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"b", "=", 
        RowBox[{"Z2", "-", "Z1"}]}], ";", 
       RowBox[{"(*", " ", "b\:4e3a\:533a\:95f4\:957f\:5ea6", " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"x", "=", 
        RowBox[{"N", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Cos", "[", 
             FractionBox[
              RowBox[{"i", " ", "\[Pi]"}], 
              RowBox[{"n", "-", "1"}]], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "0", ",", 
              RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}], ",", "myPrec"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"x", "=", 
        RowBox[{
         RowBox[{
          FractionBox["b", "2"], 
          RowBox[{"(", 
           RowBox[{"x", "+", "1"}], ")"}]}], "+", "Z1"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"c", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"1", ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";", 
       RowBox[{
        RowBox[{"c", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "=", "2"}], ";", 
       RowBox[{
        RowBox[{"c", "[", 
         RowBox[{"[", 
          RowBox[{"-", "1"}], "]"}], "]"}], "=", "2"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"d", "=", 
        RowBox[{"N", "[", 
         RowBox[{
          RowBox[{
           FractionBox["2", "b"], 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"i", "\[NotEqual]", "j"}], ",", 
               RowBox[{
                FractionBox[
                 RowBox[{"c", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], 
                 RowBox[{"c", "[", 
                  RowBox[{"[", "j", "]"}], "]"}]], 
                FractionBox[
                 SuperscriptBox[
                  RowBox[{"(", 
                   RowBox[{"-", "1"}], ")"}], 
                  RowBox[{"i", "+", "j"}]], 
                 RowBox[{
                  RowBox[{"x", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], "-", 
                  RowBox[{"x", "[", 
                   RowBox[{"[", "j", "]"}], "]"}]}]]}], ",", "0"}], "]"}], 
             ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "1", ",", "n"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ",", 
          "myPrec"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", "d\:662fChebyshev\:6c42\:5bfc\:77e9\:9635", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"d", "=", 
        RowBox[{"d", "-", 
         RowBox[{"DiagonalMatrix", "[", 
          RowBox[{"Total", "[", 
           RowBox[{"d", ",", 
            RowBox[{"{", "2", "}"}]}], "]"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Return", "[", 
        RowBox[{"{", 
         RowBox[{"d", ",", "x"}], "}"}], "]"}]}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}]], "Input",

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Sigma]", "\[LongEqual]", "0", ",", 
         RowBox[{"(", 
           RowBox[{
             SuperscriptBox[
              StyleBox["x", "TI"], "2"], "-", "1"}], ")"}], 
         SuperscriptBox["\[CapitalPhi]", 
          RowBox[{"(", 
            RowBox[{"0", ",", "2"}], ")"}]], "+", "2", 
         StyleBox["x", "TI"], 
         SuperscriptBox["\[CapitalPhi]", 
          RowBox[{"(", 
            RowBox[{"0", ",", "1"}], ")"}]], "\[LongEqual]", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\sigma=0, \\left(x^2-1\\right) \\Phi ^{(0,2)}+2 x \\Phi ^{(0,1)}=0", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b1dc422b-614d-4c01-8e5f-bc859886f24d"],
 " \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Sum]", 
         StyleBox["l", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["l", "TI"], "+", "1"}], ")"}], 
         SubscriptBox["\[CapitalPhi]", 
          StyleBox["l", "TI"]], 
         RowBox[{"(", 
           RowBox[{"\[Sigma]", "\[LongEqual]", "0"}], ")"}], 
         SubscriptBox[
          StyleBox["P", "TI"], 
          StyleBox["l", "TI"]], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "\[LongEqual]", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\sum l(l+1)\\Phi_l(\\sigma=0) P_l(x)=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "aa8d58d2-09e6-4b98-bab8-f7e222726a79"],
 "\nThus, the boundary condition at \[Sigma] = 0 is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalPhi]", 
         RowBox[{"(", 
           RowBox[{"\[Sigma]", "\[LongEqual]", "0", ",", 
             StyleBox["x", "TI"]}], ")"}], "\[LongEqual]", 
         SubscriptBox["\[CapitalPhi]", "0"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\Phi(\\sigma=0,x)=\\Phi_0", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "affc22f1-c693-4d31-9c61-0db6e7ca45eb"]
}], "Text",
 CellChangeTimes->{{3.967231700243128*^9, 3.96723177015942*^9}, {
  3.96723191619446*^9, 3.9672319294205647`*^9}, {3.967231987690696*^9, 
  3.967232047713401*^9}, {3.9672322136594467`*^9, 
  3.967232214461987*^9}},ExpressionUUID->"a1f7ecc3-7622-47f6-85b8-\
b111ded37cfe"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"tmp", "=", 
   RowBox[{"IdentityMatrix", "[", "n\[Sigma]", "]"}]}], ";", 
  RowBox[{
   RowBox[{"tmp", "[", 
    RowBox[{"[", 
     RowBox[{
      RowBox[{"-", "1"}], ",", 
      RowBox[{"-", "1"}]}], "]"}], "]"}], "=", "0"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"A\[Sigma]", "[", 
    RowBox[{"[", 
     RowBox[{
      RowBox[{"-", "1"}], ",", 
      RowBox[{"-", "1"}]}], "]"}], "]"}], "=", "1"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Am0", "=", 
   RowBox[{
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{"A\[Sigma]", ",", 
      RowBox[{"IdentityMatrix", "[", "nx", "]"}]}], "]"}], "+", 
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{"tmp", ",", "Ax"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"b\[Sigma]", "=", 
    RowBox[{"0", "*", "\[Sigma]\[Sigma]"}]}], ";", 
   RowBox[{
    RowBox[{"b\[Sigma]", "[", 
     RowBox[{"[", 
      FractionBox[
       RowBox[{"n\[Sigma]", "+", "1"}], "2"], "]"}], "]"}], "=", "1"}], ";"}],
   "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Delta]", 
         RowBox[{"(", 
           RowBox[{"\[Theta]", "-", 
             SuperscriptBox["\[Theta]", "\[Prime]"]}], ")"}], "\[LongEqual]", 
         
         FractionBox[
          RowBox[{"\[Delta]", "(", 
            RowBox[{
              StyleBox["x", "TI"], "-", 
              SuperscriptBox[
               StyleBox["x", "TI"], "\[Prime]"]}], ")"}], 
          RowBox[{"1", "/", 
            SqrtBox[
             RowBox[{"1", "-", 
               SuperscriptBox[
                StyleBox["x", "TI"], 
                RowBox[{"\[Prime]", "2"}]]}]]}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\delta(\\theta-\\theta^\\prime)=\\frac{\\delta(x-x^\\prime)}{1/\\sqrt{\
1-x^{\\prime2}}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bx", "=", 
   RowBox[{"0", "*", "xx"}]}], ";", 
  RowBox[{
   RowBox[{"bx", "[", 
    RowBox[{"[", 
     FractionBox[
      RowBox[{"nx", "+", "1"}], "2"], "]"}], "]"}], "=", "1"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bm0", "=", 
   RowBox[{
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{"b\[Sigma]", ",", "bx"}], "]"}], "//", "Flatten"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"bm0", "[", 
    RowBox[{"[", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"(", "nx", ")"}]}], ";;", 
      RowBox[{"-", "1"}]}], "]"}], "]"}], "=", 
   RowBox[{
    RowBox[{"0", "*", 
     RowBox[{"bm0", "[", 
      RowBox[{"[", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"(", "nx", ")"}]}], ";;", 
        RowBox[{"-", "1"}]}], "]"}], "]"}]}], "+", 
    RowBox[{"Phi0", "[", 
     RowBox[{"[", 
      RowBox[{"-", "1"}], "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalPhi]m0", " ", "=", 
   RowBox[{"LinearSolve", "[", 
    RowBox[{"Am0", ",", "bm0"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"ListPlot3D", "[", 
  RowBox[{
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{"\[Sigma]\[Sigma]", ",", 
         RowBox[{
          RowBox[{"0", "*", "xx"}], "+", "1"}]}], "]"}], "//", "Flatten"}], 
      ",", 
      RowBox[{
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"0", "*", "\[Sigma]\[Sigma]"}], "+", "1"}], ",", "xx"}], 
        "]"}], "//", "Flatten"}], ",", 
      RowBox[{"Abs", "[", "\[CapitalPhi]m0", "]"}]}], " ", "}"}], "]"}], ",", 
   
   RowBox[{"PlotRange", "->", "All"}], ",", 
   RowBox[{"PlotTheme", "->", "\"\<Scientific\>\""}], ",", 
   RowBox[{"ColorFunction", "->", "\"\<RedBlueTones\>\""}], ",", 
   RowBox[{"PlotLegends", "->", "Automatic"}], ",", 
   RowBox[{"Boxed", "->", "True"}], ",", 
   RowBox[{"Axes", "->", "True"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{
     "\"\<\[Sigma]\>\"", ",", "\"\<x\>\"", ",", "\"\<\[CapitalPhi]\>\""}], 
     "}"}]}], ",", 
   RowBox[{"AxesStyle", "->", 
    RowBox[{"Directive", "[", 
     RowBox[{"Black", ",", "Thick"}], "]"}]}]}], "]"}]}], "Input",

Cell[BoxData[
 RowBox[{"Timing", "[", "\[IndentingNewLine]", 
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{"ni", "=", "0"}], ",", 
    RowBox[{"ni", "<=", "nmax"}], ",", 
    RowBox[{"ni", "++"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"list$l", "=", 
      RowBox[{"oddEvenList$l", "[", "ni", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"li", "=", "1"}], ",", 
       RowBox[{"li", "<=", 
        RowBox[{"Length", "[", "list$l", "]"}]}], ",", 
       RowBox[{"li", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"list$m", "=", 
         RowBox[{"oddEvenList$m", "[", 
          RowBox[{"list$l", "[", 
           RowBox[{"[", "li", "]"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"mi", "=", "1"}], ",", 
          RowBox[{"mi", "<=", 
           RowBox[{"Length", "[", "list$m", "]"}]}], ",", 
          RowBox[{"mi", "++"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"ll", "=", 
            RowBox[{"list$l", "[", 
             RowBox[{"[", "li", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"mm", "=", 
            RowBox[{"list$m", "[", 
             RowBox[{"[", "mi", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"expr", "=", 
            RowBox[{
             RowBox[{"SeriesCoefficient", "[", 
              RowBox[{"CSeries", ",", 
               RowBox[{"ni", "-", "2"}]}], "]"}], "//", "Expand"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Clear", "[", "replace$Integ", "]"}]}], "\:ff1b", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"replace$Integ", "[", "expr_", "]"}], ":=", 
            RowBox[{"replace$Integ$lm", "[", 
             RowBox[{"expr", ",", "ll", ",", "mm"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"terms", "=", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Head", "[", "expr", "]"}], "===", "Plus"}], ",", 
              RowBox[{"List", "@@", "expr"}], ",", 
              RowBox[{"{", "expr", "}"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"CCoef", "[", 
             RowBox[{"ll", ",", "mm", ",", "ni"}], "]"}], "=", 
            RowBox[{
             RowBox[{"Total", "[", 
              RowBox[{"replace$Integ", "/@", "terms"}], "]"}], "//", 
             "Simplify"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"\[CapitalPhi]$coef$list", "=", 
            RowBox[{"Append", "[", 
             RowBox[{"\[CapitalPhi]$coef$list", ",", 
              RowBox[{"\[CapitalPhi]", "[", 
               RowBox[{"ll", ",", "mm", ",", "ni"}], "]"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"eqs", "=", 
            RowBox[{"Append", "[", 
             RowBox[{"eqs", ",", 
              RowBox[{
               RowBox[{"\[CapitalPhi]", "[", 
                RowBox[{"ll", ",", "mm", ",", "ni"}], "]"}], "==", 
               FractionBox[
                RowBox[{"CCoef", "[", 
                 RowBox[{"ll", ",", "mm", ",", "ni"}], "]"}], 
                RowBox[{
                 RowBox[{"ni", 
                  RowBox[{"(", 
                   RowBox[{"ni", "+", "1"}], ")"}]}], "-", 
                 RowBox[{"ll", 
                  RowBox[{"(", 
                   RowBox[{"ll", "+", "1"}], ")"}]}]}]]}]}], "]"}]}], ";"}]}],
          "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", "]"}]}]}], 

  RowBox[{"tmp", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"SeriesCoefficient", "[", 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        FractionBox["s", "\[Sigma]"]], ",", 
       RowBox[{"{", 

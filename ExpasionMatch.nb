Cell[BoxData[
 RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}]], "Input",
 CellLabel->
  "In[483]:=",ExpressionUUID->"ca72c8a2-047e-4747-a1e8-c4c146d15e7f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"M", "=", "1"}], ";", 
  RowBox[{"\[Lambda]", "=", 
   RowBox[{"4", "*", "M"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"l", "=", "2"}], ";", 
  RowBox[{"m", "=", "2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalOmega]", "=", 
   RowBox[{"5", "*", 
    RowBox[{
     SuperscriptBox["10", "0"], "/", "M"}]}]}], ";", 
  RowBox[{"\[Omega]", "=", 
   RowBox[{"m", "*", "\[CapitalOmega]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"s", "=", 
   RowBox[{
    RowBox[{"-", "I"}], "*", "\[Lambda]", "*", "\[Omega]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.967790459632133*^9, 3.967790501465392*^9}, {
   3.9677905437212467`*^9, 3.967790572336061*^9}, 3.967790605846591*^9, 
   3.9677906609977837`*^9, {3.967790698696183*^9, 3.9677907008180437`*^9}, {
   3.9677970245039473`*^9, 3.967797090724113*^9}, 3.9680351663600607`*^9, {
   3.968035693912828*^9, 3.968035710722639*^9}, {3.9680358783321323`*^9, 
   3.968035899884919*^9}, {3.9680359500843573`*^9, 3.9680359552729*^9}, 
   3.968036040768223*^9, 3.968037329331188*^9, 3.9680376578581343`*^9, 
   3.96803855956329*^9},
 CellLabel->

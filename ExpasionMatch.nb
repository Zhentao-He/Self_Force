Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Alpha]", "[", "n_", "]"}], ":=", 
   RowBox[{
    RowBox[{"\[Alpha]", "[", "n", "]"}], "=", 
    RowBox[{"SeriesCoefficient", "[", 
     RowBox[{
      FractionBox[
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        RowBox[{"4", " ", "t"}], "-", 
        RowBox[{"3", " ", 
         SuperscriptBox["t", "2"]}], "+", 
        RowBox[{"s", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", 
           RowBox[{"4", " ", "t"}], "-", 
           RowBox[{"2", " ", 

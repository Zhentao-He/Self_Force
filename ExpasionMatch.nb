       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", "t"}], ")"}], "2"]], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", "n"}], "}"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Beta]", "[", "n_", "]"}], ":=", 
   RowBox[{
    RowBox[{"\[Beta]", "[", "n", "]"}], "=", 
    RowBox[{"SeriesCoefficient", "[", 
     RowBox[{
      FractionBox[
       RowBox[{
        RowBox[{"-", "1"}], "-", "l", "-", 
        SuperscriptBox["l", "2"], "+", 
        RowBox[{
         SuperscriptBox["s", "2"], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "2"}], "+", "t"}], ")"}]}], "+", 
        RowBox[{"2", " ", "s", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", "t"}], ")"}]}], "+", "t"}], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", "t"}], ")"}], "2"]], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", "n"}], "}"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Gamma]", "[", "n_", "]"}], ":=", 
   RowBox[{
    RowBox[{"\[Gamma]", "[", "n", "]"}], "=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"n", "==", "0"}], ",", "1.0", ",", 
      RowBox[{
       FractionBox["1", 
        RowBox[{"n", 
         RowBox[{"(", 
          RowBox[{"n", "-", "1", "-", 
           RowBox[{"\[Alpha]", "[", "0", "]"}]}], ")"}]}]], 
       RowBox[{"(", 
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"k", "=", "1"}], "n"], 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"n", "-", "k"}], ")"}], "*", 

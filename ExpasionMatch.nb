Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"a", "[", "n_", "]"}], ":=", 
   RowBox[{
    RowBox[{"a", "[", "n", "]"}], "=", 
    RowBox[{"SeriesCoefficient", "[", 
     RowBox[{
      FractionBox[
       RowBox[{
        RowBox[{"\[Sigma]", 
         RowBox[{"(", 
          RowBox[{"2", "-", 
           RowBox[{"3", "\[Sigma]"}]}], ")"}]}], "+", 
        RowBox[{"s", 
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{"2", 
            SuperscriptBox["\[Sigma]", "2"]}]}], ")"}]}]}], 
       RowBox[{"1", "-", "\[Sigma]"}]], ",", 
      RowBox[{"{", 
       RowBox[{"\[Sigma]", ",", "0", ",", "n"}], "}"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"b", "[", "n_", "]"}], ":=", 
   RowBox[{
    RowBox[{"b", "[", "n", "]"}], "=", 
    RowBox[{"SeriesCoefficient", "[", 
     RowBox[{
      FractionBox[
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"l", 
           RowBox[{"(", 
            RowBox[{"l", "+", "1"}], ")"}]}], "+", 
          RowBox[{"\[Sigma]", 
           RowBox[{"(", 
            RowBox[{"1", "+", 
             RowBox[{"2", "s"}]}], ")"}]}], "+", 
          RowBox[{
           SuperscriptBox["s", "2"], 
           RowBox[{"(", 
            RowBox[{"1", "+", "\[Sigma]"}], ")"}]}]}], ")"}]}], 
       RowBox[{"1", "-", "\[Sigma]"}]], ",", 
      RowBox[{"{", 
       RowBox[{"\[Sigma]", ",", "0", ",", "n"}], "}"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"c", "[", "n_", "]"}], ":=", 
   RowBox[{
    RowBox[{"c", "[", "n", "]"}], "=", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"n", "==", "0"}], ",", "1.0", ",", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"n", "==", "1"}], ",", 
        RowBox[{
         RowBox[{"-", 
          FractionBox[
           RowBox[{"b", "[", "0", "]"}], 
           RowBox[{"a", "[", "0", "]"}]]}], 
         RowBox[{"c", "[", "0", "]"}]}], ",", 
        RowBox[{
         FractionBox[
          RowBox[{"-", "1"}], 
          RowBox[{"n", "*", 
           RowBox[{"a", "[", "0", "]"}]}]], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"c", "[", 
             RowBox[{"n", "-", "1"}], "]"}], 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"n", "-", "1"}], ")"}], 
               RowBox[{"(", 
                RowBox[{"n", "-", "2"}], ")"}]}], "+", 
              RowBox[{"b", "[", "0", "]"}]}], ")"}]}], "+", 
           RowBox[{
            UnderoverscriptBox["\[Sum]", 
             RowBox[{"j", "=", "0"}], 
             RowBox[{"n", "-", "2"}]], 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"j", "+", "1"}], ")"}], 
               RowBox[{"c", "[", 
                RowBox[{"j", "+", "1"}], "]"}], "*", 
               RowBox[{"a", "[", 
                RowBox[{"n", "-", "j", "-", "1"}], "]"}]}], "+", 
              RowBox[{
               RowBox[{"c", "[", "j", "]"}], 
               RowBox[{"b", "[", 
                RowBox[{"n", "-", "j", "-", "1"}], "]"}]}]}], ")"}]}]}], 
          ")"}]}]}], "]"}]}], "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.967789675330029*^9, 3.9677897124282417`*^9}, {
